# Personal use on this computer only. No login is shown and no passwords required.
# SQLite is the only server database; it is also the default when omitted.
DATABASE_MODE=sqlite
SQLITE_PATH=./data/buildledger.sqlite
AUTH_MODE=local
HOST=127.0.0.1
PORT=8080

# Optional, ONLY for a secured deployment with login:
# AUTH_MODE=owner
# ADMIN_PASSWORD=REPLACE_WITH_LONG_UNIQUE_OWNER_PASSWORD
# APP_COOKIE_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# List only exact socket peer IPs of your HTTPS proxy; no hostnames or CIDR ranges.
# The proxy must preserve Host and overwrite X-Forwarded-Proto with https.
